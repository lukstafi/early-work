LOC      OBJ            LINE     SOURCE
                           1     .VERS "ST6263"
                           2     .ROMSIZE 2
                           3     ;;; analogowy pomiar B z opcja zatrzasku do pamieci, histereza + dl. impulsu + opozn. puszczenia + wersja wyjscia proby
                           4     ;;; pomiar pradu stalego, wykazywanie poziomu pomiaru, opcje:
                           5     ;;; (0) test kwantylowy (hipoteza: zmiana poziomu, test kwantylowy rzedu BEZWLAD/OKRES, test medianowy dla OKRES = 2*BEZWLAD)
                           6     ;;; (1) dlugosc impulsu + opoznienie (dlugosc impulsu: CZASPOMB, opoznienie OPZNDIOD)
                           7     ;;; (2) dlugosc impulsu + glosowanie (test medianowy, dlugosc impulsu: CZASPOMB)
                           8     ;;; stan awaryjny: piki odfiltrowywane dlugoscia impulsu, (spadki odfiltrowywac?)
                           9     ;;; synchronizacja progu 5 i diody B, histereza PROG5 / PUSCB na progu 5
                          10     ;;; opcja wyjscia proby
                          11     
                          12     ;;; pomiar zasilania:
                          13     ;;; wejscie:	PC4 (pin 18) analogowe
                          14     ;;; pomiar z histereza ZASILANIE / ZASICHWYC
                          15     ;;; pomiar B:
                          16     ;;; wejscie:	PC3 (pin 19) analogowe
                          17     ;;; wyjscia:	PB0 (pin 1) -- ledP i przekaznik; PB1 -- ledB, PA3 -- ledM; PB2, PB3, PB6, PB7, PA0, PA1, PA2 -- progi
                          18     ;;; wyjscia push-pull
                          19     ;;; pomiar B opcja zatrzask:
                          20     ;;; zatrzask po impulsie dlugosci CZASPOMB na poziomie PROG5, zapis do pamieci EEPROM
                          21     ;;; dlugosc impulsu dla kasowania TRZYMAJB * 255
                          22     ;;; pomiar B opcja bez zatrzasku:	
                          23     ;;; pomiar z histereza PROG5 / PUSCB, dlugosc impulsu CZASPOMB,
                          24     ;;; dlugosc impulsu dla puszczenia TRZYMAJB * 255, zatrzask diody ledM
                          25     ;;; funkcja ledM:
                          26     ;;; w opcji z zatrzaskiem, ledM wykazuje przywrocenie zatrzasku zapamietanego przed resetem (zanikiem napiecia)
                          27     ;;; w opcji bez zatrzasku, ledM wykazuje wystapienie pomiaru awaryjnego i nie gasnie az do skasowania
                          28     ;;; w wersji bez ledM w opcji bez zatrzasku dioda M, kasowanie i pamiec EEPROM sa nieaktywne
                          29     ;;; kasowanie zatrzasku:
                          30     ;;; wejscie:	PC2 (pin 20) cyfrowe, zboczem opadajacym
                          31     ;;; dlugosc impulsu KTRLKAS * 255, w opcji bez zatrzasku kasuje ledM
                          32     ;;; kasowanie jest nieaktywne w trybie wyjscia proby
                          33     ;;; opcja zatrzasku:
                          34     ;;; wejscie:	PA3 (pin 13) analogowe,
                          35     ;;; wlaczenie stanem ponizej POMZATRZ dlugosc impulsu wlaczajacego/wylaczajacego CZASZATRZ
                          36     ;;; pomiar dokonywany okresowo (okres KTRLZAT * 255), dopiero w czasie kontroli impulsu w kazdym obiegu petli
                          37     ;;; po restarcie pomiar dokonywany przed wejsciem do petli
                          38     ;;; pamiec zatrzasku:
                          39     ;;; wyjscie:	PA3 (pin 13) -- ledM
                          40     ;;; jesli po restarcie opcja zatrzasku jest wlaczona i jest zapamietany zatrzask,
                          41     ;;; jest on wlaczany i zapalana ledM
                          42     ;;; przelaczanie opcji i dioda M:
                          43     ;;; przy wlaczaniu opcji zatrzasku dioda M jest gaszona
                          44     ;;; przy wylaczaniu opcji zatrzasku i swiecacej B (jest zatrzask) dioda M jest zaswiecana
                          45     ;;; przy powrocie napiecia w opcji z zatrzaskiem, jesli przed zanikiem swiecila M, wchodzi zatrzask, swieca B i M
                          46     ;;; wersja z wyjsciem proby:
                          47     ;;; wejscie: PC2 (w trybie wejscia), wyjscie: PC2 (w trybie wysylania proby), PA3 (ledM)
                          48     ;;; po sygnale na PC2 dlugosci WYJPROBY * 255 przelacza PC2 w wyjscie w stanie wysokim na czas DLPROBY * 255
                          49     ;;; jednoczesnie mruga dioda ledM z okresem SYGPROBY * 255 * 2
                          50     ;;; opoznienie startu:
                          51     ;;; dodatkowa petla przed rozpoczeciem pomiarow (OPOZST)
                          52     ;;; opoznienie po powrocie zasilania:
                          53     ;;; OPOZAS dobrych pomiarow dopiero przywraca prace
                          54     
                          55     ;;; port C:	2 wej cyfrowe (wyjscie push-pull w trybie proby) 3,4 wej analogowe
                          56     ;;; port B:	0-3, 6, 7 wyjscia push-pull
                          57     ;;; port A:	0-3 wyjscia push-pull, 3 okresowo wejscie analogowe
                          58     
  0001                    59     LEDM		.equ	1	; funkcjonalnosc ledM (0 -- wylaczona)
  0001                    60     DEBUG		.equ	1	; zawsze ustawiac DEBUG .equ 0
  0001                    61     PROBA		.equ	1	; 1 -- wlaczona opcja proby, 0 -- wylaczana
  0002                    62     TYPDIOD	.equ	2	; 0 -- test kwantylowy, 1 -- dlugosc impulsu + opoznienie, 2 -- dlugosc impulsu + glosowanie
  0064                    63     OPOZST		.equ	100	; opoznienie startu - musi byc wieksze niz zero
  0003                    64     KTRLKAS		.equ	3	; kontrola kasowania (starszy bajt) (1 bez opoznienia)- jak dlugo wcisniete, zeby uwzglednic
                          65     	.IFC NE PROBA
  0014                    66     WYJPROBY		.equ	20	; dlugosc stanu wysokiego na PC2 wyprowadzajaca probe
  000A                    67     DLPROBY		.equ	10	; dlugosc trwania proby
  0002                    68     SYGPROBY		.equ	2	; polowa okresu mrugania ledM w trybie wyjscia proby
                          69     	.ENDC
  000A                    70     KTRLZAT		.equ	10	; kontrola opcji zatrzasku (starszy bajt)
  0076                    71     ZASILANIE	.equ	118	; 118 = czesc calkowita z 256 * 0.49 * 4.7 / 5 (jest 14,6V~tj.0,60Uz)
  00A8                    72     ZASICHWYC	.equ	168   ; 168 =                   256 * 0.7 * 4.7 / 5 (ok.0,75Uz)
  0064                    73     OPOZAS		.equ	100	; opoznienie przy powrocie zasilania
  0032                    74     POMZATRZ	.equ	50	; ok 1V prog wylaczenia zatrzasku
  0064                    75     CZASZATRZ	.equ	100	; dlugosc impulsu dla opcji zatrzasku
  0003                    76     TRZYMAJB	.equ	3	; opoznienie puszczenia B (starszy bajt)
  005A                    77     CZASPOMB	.equ	90	; wymagany czas pomiaru B (dlugosc impulsu)(90x0,6ms=54ms)
                          78     	.IFC EQ TYPDIOD
                                 OKRES		.equ	100	; suma pomiarow na zmiane stanu diod
                                 BEZWLAD	.equ	70	; ilosc pomiarow pozwalajacych na zmiane,grawitacja
                                 	.ENDC
                          82     	.IFC EQ TYPDIOD-1
  0064                    83     OPZNDIOD	.equ	100	; opoznienie powrotu do poprzedniego poziomu diod
                          84     	.ENDC
                          85     	.IFC EQ TYPDIOD-2
  0004                    86     KWORUM	.equ	4		; ilosc impulsow przyp. na glosowanie (powinna byc parzysta!)
  0003                    87     BEZWLAD	.equ	(KWORUM/2)+1
                          88     	.ENDC
                          89     	;; (hipoteza: zmiana poziomu, test kwantylowy rzedu BEZWLAD/OKRES)
  0005                    90     PROG1		.equ	5	; progi pomiarowe
  0008                    91     PROG2		.equ	8
  0017                    92     PROG3		.equ	23
  0038                    93     PROG4		.equ	56
  0050                    94     PUSCB		.equ	80
  0052                    95     PROG5		.equ	82
  0079                    96     PROG6		.equ	121
  0093                    97     PROG7		.equ	147
                          98     
                          99     ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                         100     ;; struktura programu:
                         101     ; 1. definicje stalych programu
                         102     ; 2. definicje adresow zmiennych i rejestrow
                         103     ; 3. tekst informujacy o ustawieniach
                         104     ; 4. INIT: poczatek programu, inicjalizacja zmiennych i ustawien rejestrow
                         105     ; 5. OPOZST1: opoznienie wejscia do petli glownej
                         106     ; 6. ZATRZOPC-ZATRZKON: pomiar opcji zatrzasku, inicjalizacja ledM z pamieci
                         107     ; filtrowanie: ktora opcja pierwsza przekroczy CZASZATRZ pomiarow
                         108     ; 7. PETLA-USTAWB: petla glowna, kontrola zasilania, powrot z braku zasilania
                         109     ; 8. PRACA: czesc robocza petli
                         110     ; 9. ROBPOM1-RMNIEJ: pomiar B z okresleniem poziomu na pasku diod
                         111     ; 9a. HISTEREZA-DOPAMIECI: synchronizacja pomiaru B z poziomem 5, zatrzask pomiaru B
                         112     ; 10. JUZSWIEC-POZMIANIE: wyswietlenie stanu na pasku diod (tylko w cyklach, w ktorych zmiana)
                         113     ; 11. TESTGUZIK-POTESCIE: obsluga guzika kasowania, przeprowadzenie kasowania i wysylanie proby
                         114     ; 11a. KROKPROBA-KONPROBY: obsluga wysylania proby
                         115     ; 12. OPOZNIENIE-OPOZN3: opoznienie chwycenia przekaznika i zgaszenia ledB
                         116     ; 13. DOZMZATRZ-NIECZYSC: pomiar opcji zatrzasku i obsluga przelaczenia opcji zatrzasku
                         117     ; 14. DO4PETLI: zapetlij
                         118     ; 15. PISZPAMV-CZYTPAMA: funkcje pomocnicze
                         119     ; PRZYWRM: zaswieca ledM wtw gdy MSTAN
                         120     ; 16. ADCINT-NMINT: przerwania	
                         121     ; 17. ustawienie przerwan (i poczatku programu - przerwanie RESET)
                         122     ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                         123     
                         124     
  00FF                   125     A	.def 0ffh		; akumulator
  0080                   126     X     .def 080h			; rejestr adresowy
  0081                   127     Y	.def 081h		; rejestr adresowy
  0082                   128     V     .def 082h		; rejestr danych
  0083                   129     W     .def 083h		; rejestr danych
  0084                   130     GUST	.def 084h	; starszy bajt licznika przycisku kasowania (czy dosc dlugo trzymany) liczy w gore
  0085                   131     GUML	.def 085h	; mlodszy bajt przycisku kasowania (odlicza w dol)
  0086                   132     PBST	.def 086h	; starszy bajt opoznienia puszczenia B
  0087                   133     PBML	.def 087h	; mlodszy bajt opoznienia puszczenia B
  0088                   134     BTRZ	.def 088h	; znacznik trzymania blednego pomiaru (tzn. ledB swieci, Pk nie trzyma)
  0089                   135     POMB	.def 089h	; bajt odliczania w dol blednych pomiarow B
  008A                   136     ZATRZ	.def 08ah		; opcja z zatrzaskiem czy bez
                         137     	.IFC EQ TYPDIOD
                                 WIEKSZ	.def 08bh	; ilosc przekroczen ponad POZIOM
                                 MNIEJ	.def 08ch	; ilosc spadkow ponizej POZIOM
                                 CZAS	.def 08dh	; licznik petli - odmierza "okresy" pomiarowe
                                 	.ENDC
                         142     	.IFC EQ TYPDIOD-1
  008B                   143     DIKIER	.def 08bh	; kierunek zmian na diodach: 1 -- wzrost, 2 -- spadek
  008C                   144     DIPOMZM	.def 08ch	; zliczanie dlugosci impulsu w kierunku zmiany
  008D                   145     DIOPOZ	.def 08dh	; licznik opoznienia na diodach
  008E                   146     DIPOMPZ	.def 08eh	; zliczanie dlugosci impulsu dla pozostania na wykazywanym pozmiomie
                         147     	.ENDC
                         148     	.IFC EQ TYPDIOD-2
  008B                   149     WIEKSZ	.def 08bh	; ilosc impulsow ponad POZIOM
  008C                   150     MNIEJ	.def 08ch	; ilosc impulsow ponizej POZIOM
  008D                   151     CZAS	.def 08dh	; licznik petli - zlicza impulsy
  008E                   152     DIWIEKSZ	.def 08eh	; zliczanie dlugosci impulsu ponad POZIOM
  008F                   153     DIMNIEJ	.def 08fh	; zliczanie dlugosci impulsu ponizej POZIOM
                         154     	.ENDC
  0090                   155     POZIOM	.def 090h	; aktualnie wykazywany poziom
  0091                   156     MSTAN	.def 091h		; stan diody M (tzn. 3, DRA)
  0092                   157     ZASOPOZ .def 092h		; licznik opoznienia przy powrocie zasilania
  0093                   158     JESTZAT	.def 093h		; licznik pomiarow na wlaczenie zatrzasku (ponizej progu)
  0094                   159     NIEZAT	.def 094h		; licznik pomiarow na wylaczenie zatrzasku (powyzej progu)
  0095                   160     ZATST	.def 095h		; starszy bajt licznika kontroli opcji zatrzasku
  0096                   161     ZATML	.def 096h		; mlodszy --||--
  0097                   162     STANORC	.def 097h	; aktualne ustawienie portu C
  0004                   163     ORCWYJPR	.equ 100b	; mozliwe wartosci opcji portu C
  0000                   164     ORCKAS	.equ 0		;
                         165     	.IFC NE PROBA
  0098                   166     PROBST	.def 098h	; starszy bajt licznika wyprowadzania proby (jako mlodszy bajt KAML)
  0099                   167     PROBML	.def 099h
  009A                   168     MIGMST	.def 09ah	; licznik mrugania ledM w czasie wyprowadzania proby
                         169     	.ENDC
                         170     	.IFC NE DEBUG		; wersja DEBUGgera
  009D                   171     DBZASIL	.def 09dh		; wartosc pomiaru zasilania
  009E                   172     DBPOMB	.def 09eh		; wartosc pomiaru B
  009F                   173     DBZATRZ	.def 09fh		; wartosc pomiaru trybu zatrzasku
  00A0                   174     DBGUZIK	.def 0a0h		; stan guzika kasowania
                         175     	.ENDC
                         176     	
  0000                   177     PAMIEC	.def 000h		; pamiec zatrzasku (jesli =/= 0 byl zatrzask)
                         178     
                         179     
  00C0                   180     DRA   .def 0c0h		; pierwszy port
  00C4                   181     DDRA	.def 0c4h		
  00CC                   182     ORA	.def 0cch
  00C1                   183     DRB	.def 0c1h      ; drugi port
  00C5                   184     DDRB	.def 0c5h
  00CD                   185     ORB	.def 0cdh
  00C2                   186     DRC	.def 0c2h      ; trzeci port
  00C6                   187     DDRC	.def 0c6h
  00CE                   188     ORC	.def 0ceh
  00D1                   189     ADCR	.def 0d1h		; przetwornik A/D
  00D0                   190     ADR	.def 0d0h
  00D8                   191     WDR	.def 0d8h		; watchdog - resetowanie przy pozostawaniu poza petla
  00C8                   192     IOR	.def 0c8h		; rejestr przerwan
  00E8                   193     DRBR	.def 0e8h	; Data RAM/EEPROM Bank Register
  00EA                   194     EECTL	.def 0eah	; EEPROM Control Register
